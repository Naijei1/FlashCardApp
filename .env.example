# Copy to .env.local for development. Never commit real values.
# Leave AUTH_MODE unset (or shared) to keep the single shared password.
APP_PASSWORD=replace-with-a-strong-password
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-64-hex-chars
TABLE_NAME=flashcards-dev
APP_REGION=us-east-1
# IANA timezone used for calendar-day review forecasts
APP_TIME_ZONE=America/New_York
# Optional: point at DynamoDB Local for offline dev
# DYNAMODB_ENDPOINT=http://localhost:8000

# Multi-user cutover. Do not set these on Amplify until Google OAuth is ready
# and the migration has been applied to a copy. Unset DATA_MODE, or set it to
# legacy, to roll reads back to the original card items.
# AUTH_MODE=google
# DATA_MODE=multi-user
# AUTH_SECRET=replace-with-64-hex-chars
# AUTH_GOOGLE_ID=your-client-id.apps.googleusercontent.com
# AUTH_GOOGLE_SECRET=replace-with-the-google-client-secret
# AUTH_URL=http://localhost:3000
# Comma-separated verified Google emails. Do not put the study account here.
# ADMIN_EMAILS=admin@example.com
# LEGACY_OWNER_EMAIL=nj277@cornell.edu
